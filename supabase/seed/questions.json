{
  "version": 1,
  "locale": "fr",
  "_notes": [
    "Textes en FR ici ; à extraire dans les fichiers i18n (react-i18next) pour l'EN.",
    "Toutes les valeurs de dimensions sont sur [0,1]. 0.5 = neutre/inconnu.",
    "obs = observation [valeur_cible, fiabilité r] sur une dimension. genres = delta de poids de genre dans [-1,1].",
    "Duel : choisir A => observations sur les clés de 'sig' de A uniquement (les dimensions non testées ne bougent pas). Choisir B => idem avec B. 'sig' vide => duel de genres uniquement.",
    "Les extraits d'un duel sont choisis dans anchor_tracks par proximité avec 'sig' + 'genres' (pas de morceau en dur).",
    "Visuels (cartes d'ambiances, bulles) : générés par le front à partir de l'id de l'option (dégradés + icônes), aucun asset payant."
  ],
  "model": {
    "prior": { "mean": 0.5, "variance": 0.083 },
    "obs_variance": "v = 0.12 * (1 - r) / r + 0.01",
    "update": "Kalman 1D : K = var / (var + v) ; mean += K * (cible - mean) ; var *= (1 - K)",
    "confidence": "1 - var / 0.083",
    "multi_select_reliability_scale": 0.6,
    "time_decay": "var += 0.0005 * jours_depuis_reponse, plafonné à 0.083 (l'historique n'est jamais supprimé)",
    "genre_update": "g += 0.35 * delta * (1 - abs(g)), g dans [-1,1] ; rejet (double-tap) => g = min(g, -0.8)",
    "both": "observation = moyenne des deux signatures, fiabilité r * 0.5",
    "none": "aucune mise à jour de dimension, réponse journalisée",
    "skip": "aucun signal, jamais compté comme négatif",
    "manual_edit": "ajustement manuel d'un curseur du spectre = observation de fiabilité 0.95"
  },
  "dimensions": [
    { "id": "energy", "fr": "Énergie", "low": "calme", "high": "explosif" },
    { "id": "valence", "fr": "Humeur", "low": "mélancolique", "high": "lumineux" },
    { "id": "acoustic", "fr": "Texture", "low": "électronique", "high": "acoustique" },
    { "id": "tempo", "fr": "Tempo", "low": "lent", "high": "rapide" },
    { "id": "dance", "fr": "Groove", "low": "planant", "high": "dansant" },
    { "id": "complexity", "fr": "Complexité", "low": "direct", "high": "expérimental" },
    { "id": "vocal", "fr": "Voix", "low": "instrumental", "high": "très vocal" },
    { "id": "bass", "fr": "Basses", "low": "légères", "high": "profondes" },
    { "id": "polish", "fr": "Production", "low": "brute / lo-fi", "high": "ultra polie" },
    { "id": "warmth", "fr": "Chaleur", "low": "froid", "high": "chaleureux" },
    { "id": "era", "fr": "Époque", "low": "rétro", "high": "actuel" },
    { "id": "niche", "fr": "Singularité", "low": "mainstream", "high": "confidentiel" }
  ],
  "genres": ["pop", "rock", "indie", "metal", "punk", "hiphop", "rnb_soul", "funk_disco", "electro", "ambient", "jazz", "classical", "folk", "country", "reggae", "latin", "afro", "chanson", "kpop_jpop", "blues"],
  "params": {
    "openness": { "default": 0.5, "use": "valeur par défaut du curseur 'reste dans ma zone <-> sors de ma bulle'" },
    "nostalgia": { "default": 0.5, "use": "poids des morceaux de l'époque de jeunesse dans les recos" },
    "languages": { "default": [], "use": "filtre/boost de langue des paroles" }
  },
