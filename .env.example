# Copie ce fichier en .env.local (jamais commité) et remplis avec TES valeurs.
# Supabase → Project Settings → API. La clé "publishable" (ou "anon" legacy) est publique par nature :
# la sécurité repose sur la RLS. NE METS JAMAIS la clé secret / service_role ici.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Chemin de base de l'app. Par défaut "/spectra/" en build (GitHub Pages), "/" en dev.
# VITE_BASE_PATH=/spectra/
